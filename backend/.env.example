# Copy to .env and edit. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for SQLite (zero setup). For local PostgreSQL:
# DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_URL=

# Local AI via Ollama (free, runs on your machine). Set OLLAMA_ENABLED=false to use rule-based fallbacks only.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# Outbound job-source fetching. Leave true to allow the Refresh button to call public job APIs.
JOB_SOURCES_ENABLED=true
# Identify your app politely to job APIs / pages you fetch.
HTTP_USER_AGENT=JobPilot/0.1 (personal job-search assistant)

# Billing is intentionally OFF. Everything is free. Do not enable until you build a payment integration.
BILLING_ENABLED=false

# Max resume upload size in MB
MAX_UPLOAD_MB=5
